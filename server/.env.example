DATABASE_URL="postgresql://hostel_admin:hostel_admin@localhost:5432/hostel_complaints?schema=public"

PORT=4000
# Comma-separated list of allowed web origins. The mobile (Expo) app sends
# no Origin header and is unaffected by this; add the Expo web dev origin
# (e.g. http://localhost:8081) only if you run the app in a browser.
CLIENT_ORIGIN="http://localhost:5173"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Outgoing email (maintainer assignment, complaint closed). Leave SMTP_HOST
# empty to disable email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="KLS Hostel Portal <no-reply@example.edu>"
